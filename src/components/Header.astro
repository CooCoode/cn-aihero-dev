---
import { BASE } from '../../astro.config.mjs';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
	{ label: '术语表', href: `${BASE}/dictionary/` },
	{ label: 'Skills', href: `${BASE}/skills/` },
	{ label: '指南', href: `${BASE}/start-here/` },
	{ label: '关于', href: `${BASE}/about/` },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href.replace(/\/$/, '') + '/');
---

<>
	<!-- 常驻声明：顶栏位置不额外占高度，但每页都能看到 -->
	<aside
		aria-label="免责声明"
		class="bg-muted/40 border-border flex h-[34px] w-full items-center justify-center gap-2.5 border-b px-4 text-center text-[12px] leading-none"
	>
		<span
			class="text-primary inline-flex shrink-0 items-center rounded-[4px] border border-[var(--ah-accent-line)] px-1.5 py-1 font-mono text-[9px] font-medium uppercase leading-none tracking-[0.1em]"
		>
			非官方
		</span>
		<a
			href={`${BASE}/about/`}
			class="group inline-flex min-w-0 items-center gap-1.5 font-medium underline-offset-4"
		>
			<span class="truncate text-muted-foreground transition-colors duration-150 group-hover:text-foreground">
				本站未获 AI Hero 授权。文章与词典<b class="text-foreground font-medium">只链接原文，不翻译</b>。
			</span>
			<span aria-hidden="true" class="ah-arrow">→</span>
		</a>
	</aside>

	<header
		class="bg-background/90 border-border sticky top-0 z-50 flex h-[62px] w-full items-center gap-5 border-b px-[18px] backdrop-blur-md lg:px-11"
	>
	<a
		href={`${BASE}/`}
		class="flex shrink-0 items-center gap-2 text-[14px] font-bold tracking-[-0.02em] transition-colors duration-150 lg:text-[15px]"
	>
		<span
			class="bg-foreground text-background flex size-[26px] items-center justify-center rounded-[7px] font-mono text-[11px] font-bold"
			aria-hidden="true">AI</span
		>
		<span>AI Hero <span class="text-muted-foreground font-medium">中文</span></span>
		<span
			class="text-muted-foreground border-border hidden rounded-[3px] border px-1 py-px font-mono text-[9px] font-medium leading-none tracking-[0.06em] sm:inline"
		>
			非官方
		</span>
	</a>

	<!-- 桌面导航 -->
	<nav class="hidden lg:block" aria-label="主导航">
		<div class="flex items-center gap-0.5">
		{
			nav.map((item) => (
				<a
					href={item.href}
					aria-current={isActive(item.href) ? 'page' : undefined}
					class:list={[
						'ah-t rounded-md px-2 py-1.5 text-[12.5px] font-medium whitespace-nowrap lg:px-2.5 lg:text-[13.5px]',
						isActive(item.href)
							? 'text-foreground bg-accent'
							: 'text-muted-foreground hover:text-foreground hover:bg-accent',
					]}
				>
					{item.label}
				</a>
			))
		}
		</div>
	</nav>

	<div class="ml-auto flex shrink-0 items-center gap-2">
		<ThemeToggle />
		<a
			href="https://www.aihero.dev/s/skills-newsletter"
			class="ah-btn-primary hidden !py-1.5 !text-[12.5px] xl:inline-flex"
		>
			订阅原文更新
			<span aria-hidden="true" class="ah-arrow">→</span>
		</a>

		{/* 移动端菜单。原生 details，零 JS。桌面端用上面的内联导航。 */}
		<details class="relative lg:hidden">
			<summary
				class="ah-icon-btn text-muted-foreground list-none [&::-webkit-details-marker]:hidden"
				aria-label="菜单"
			>
				<svg
					class="size-4"
					xmlns="http://www.w3.org/2000/svg"
					fill="none"
					viewBox="0 0 24 24"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					aria-hidden="true"
				>
					<path d="M4 7h16M4 12h16M4 17h16" />
				</svg>
			</summary>
			<div
				class="border-border bg-card absolute right-0 top-full z-50 mt-2 w-52 rounded-xl border p-2 shadow-lg"
			>
				<nav class="flex flex-col" aria-label="移动端导航">
					{
						nav.map((item) => (
							<a
								href={item.href}
								aria-current={isActive(item.href) ? 'page' : undefined}
								class:list={[
									'ah-t rounded-md px-3 py-2 text-[13.5px] font-medium',
									isActive(item.href)
										? 'text-foreground bg-accent'
										: 'text-muted-foreground hover:text-foreground hover:bg-accent',
								]}
							>
								{item.label}
							</a>
						))
					}
					<a
						href="https://www.aihero.dev/s/skills-newsletter"
						class="ah-btn-primary mt-1 justify-center !text-[12.5px]"
					>
						订阅原文更新
					</a>
				</nav>
			</div>
		</details>
	</div>
</header>
</>
